pipeline {
    agent any

    environment {
        AWS_REGION     = 'us-east-1'
        ECR_REPOSITORY = 'seclock'
    }

    stages {

        stage('Checkout') {
            steps {
                git credentialsId: 'github',
                    url: 'https://github.com/abhiramisnair10/seclock-task.git',
                    branch: 'main'
            }
        }

        stage('Install Dependencies') {
            steps {
                sh '''
                    set -e

                    python3 -m venv venv
                    . venv/bin/activate

                    pip install --upgrade pip
                    pip install -r requirements.txt
                '''
            }
        }

        stage('Test') {
            steps {
                sh '''
                    set -e

                    . venv/bin/activate
                    python test_e2e.py
                '''
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('SonarQube') {
                    withCredentials([
                        string(
                            credentialsId: 'sonar-qube',
                            variable: 'SONAR_TOKEN'
                        )
                    ]) {
                        sh '''
                            set -e
                             echo "checking SonarScanner"
                             which sonar-scanner
                             sonar-scanner --version

                            sonar-scanner \
                                -Dsonar.projectKey=seclock \
                                -Dsonar.projectName=Seclock \
                                -Dsonar.sources=. \
                                -Dsonar.token=$SONAR_TOKEN
                        '''
                    }
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                sh '''
                    set -e

                    echo "======================================"
                    echo "Building SECLOCK Docker image"
                    echo "======================================"

                    docker build \
                        -t ${ECR_REPOSITORY}:${BUILD_NUMBER} .

                    echo "Docker build completed successfully."
                '''
            }
        }

        stage('Login to Amazon ECR') {
            steps {
                withAWS(
                    credentials: 'aws-ecr-cred',
                    region: "${AWS_REGION}"
                ) {
                    sh '''
                        set -e

                        AWS_ACCOUNT_ID=$(aws sts get-caller-identity \
                            --query Account \
                            --output text)

                        ECR_REGISTRY=${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com

                        echo "AWS Account: ${AWS_ACCOUNT_ID}"
                        echo "ECR Registry: ${ECR_REGISTRY}"

                        aws ecr get-login-password \
                            --region ${AWS_REGION} | \
                        docker login \
                            --username AWS \
                            --password-stdin \
                            ${ECR_REGISTRY}

                        echo "ECR login successful."
                    '''
                }
            }
        }

        stage('Push Docker Image to ECR') {
            steps {
                withAWS(
                    credentials: 'aws-ecr-cred',
                    region: "${AWS_REGION}"
                ) {
                    sh '''
                        set -e

                        AWS_ACCOUNT_ID=$(aws sts get-caller-identity \
                            --query Account \
                            --output text)

                        ECR_IMAGE=${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${ECR_REPOSITORY}:${BUILD_NUMBER}

                        echo "======================================"
                        echo "Pushing Docker Image"
                        echo "======================================"

                        echo "Image: ${ECR_IMAGE}"

                        docker tag \
                            ${ECR_REPOSITORY}:${BUILD_NUMBER} \
                            ${ECR_IMAGE}

                        docker push ${ECR_IMAGE}

                        echo "Docker image pushed successfully."
                    '''
                }
            }
        }

        stage('Update Kubernetes Manifest') {
            steps {
                withAWS(
                    credentials: 'aws-ecr-cred',
                    region: "${AWS_REGION}"
                ) {

                    /*
                     * Reuse the existing Jenkins credential:
                     * credentialsId: 'github'
                     *
                     * This credential already works in the Checkout stage.
                     */
                    withCredentials([
                        usernamePassword(
                            credentialsId: 'github',
                            usernameVariable: 'GITHUB_USER',
                            passwordVariable: 'GITHUB_TOKEN'
                        )
                    ]) {

                        sh '''
                            set -e

                            echo "======================================"
                            echo "Updating Kubernetes Manifest"
                            echo "======================================"

                            AWS_ACCOUNT_ID=$(aws sts get-caller-identity \
                                --query Account \
                                --output text)

                            ECR_IMAGE=${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${ECR_REPOSITORY}:${BUILD_NUMBER}

                            echo "New image:"
                            echo "${ECR_IMAGE}"

                            echo ""
                            echo "Updating k8s/deployment.yaml..."

                            sed -i "s|^[[:space:]]*image:.*|          image: ${ECR_IMAGE}|" k8s/deployment.yaml

                            echo ""
                            echo "Image in deployment.yaml:"
                            grep "image:" k8s/deployment.yaml

                            echo ""
                            echo "Configuring Git identity..."

                            git config user.name "Jenkins"
                            git config user.email "jenkins@localhost"

                            echo ""
                            echo "Committing Kubernetes manifest..."

                            git add k8s/deployment.yaml

                            git commit \
                                -m "Deploy seclock ${BUILD_NUMBER}" \
                                || echo "No changes to commit"

                            echo ""
                            echo "Pushing GitOps change to GitHub..."

                            git config credential.helper \
                                '!f() { echo username=$GITHUB_USER; echo password=$GITHUB_TOKEN; }; f'

                            git push origin HEAD:main

                            git config --unset credential.helper || true

                            echo ""
                            echo "GitOps manifest pushed successfully."
                        '''
                    }
                }
            }
        }

        stage('Verify GitOps Configuration') {
            steps {
                sh '''
                    set -e

                    echo "======================================"
                    echo "GitOps Configuration"
                    echo "======================================"

                    echo ""
                    echo "Image:"
                    grep "image:" k8s/deployment.yaml

                    echo ""
                    echo "Latest commit:"
                    git log -1 --oneline

                    echo ""
                    echo "Argo CD will detect this Git change."
                '''
            }
        }
    }

    post {

        success {
            echo '''
========================================
SECLOCK PIPELINE SUCCESS
========================================
Docker image pushed to ECR.
Kubernetes manifest updated.
Argo CD will deploy the new image.
'''
        }

        failure {
            echo '''
========================================
SECLOCK PIPELINE FAILED
========================================
Check the failed stage.
'''
        }
    }
}
